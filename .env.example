# ── Discord ──────────────────────────────────────────
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_TRANSCRIPT_CHANNEL_ID=
DISCORD_ALERTS_CHANNEL_ID=

# ── OpenAI (STT + 요약 단일 vendor — ADR-5) ──────────
# threads-make 키 재사용 금지. 별도 발급 필수.
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1
WHISPER_LANGUAGE=ko
SUMMARY_MODEL=gpt-4o-mini

# ── PostgreSQL (threads-make와 별도 인스턴스) ────────
# 같은 PG 서버에 database만 추가하는 방식 금지. 별도 인스턴스 필수.
DATABASE_URL=postgres://eavesdropper_user:비밀번호@<별도 호스트>:5432/eavesdropper

# ── 녹음 정책 ────────────────────────────────────────
AUTO_LEAVE_EMPTY_SECONDS=30
MP3_PART_DURATION_MINUTES=30
MP3_BITRATE_KBPS=32
END_BEHAVIOR_SILENCE_MS=1000

# ── 로그 ─────────────────────────────────────────────
LOG_LEVEL=info
TZ_DISPLAY=UTC
